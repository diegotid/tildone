    "Hold your dimming shortcut and scroll over a note. Add Shift to change all notes together.": {
      "comment": "Release highlights and contextual feature discovery.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold your dimming shortcut and scroll over a note. Add Shift to change all notes together."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado tu atajo de atenuación y desplázate sobre una nota. Añade Mayúsculas para cambiar todas las notas a la vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez votre raccourci d’atténuation et faites défiler sur une note. Ajoutez Maj pour modifier toutes les notes à la fois."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住降低不透明度的快捷键并在便笺上滚动。再按住 Shift 可同时调整所有便笺。"
          }
        }
      }
    },
    "Hold your gathering shortcut and scroll down over a note. Scroll up to restore the notes to their previous positions.": {
      "comment": "Release highlights and contextual feature discovery.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold your gathering shortcut and scroll down over a note. Scroll up to restore the notes to their previous positions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado tu atajo para reunir y desplázate hacia abajo sobre una nota. Desplázate hacia arriba para devolverlas a sus posiciones anteriores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez votre raccourci de rassemblement et faites défiler vers le bas sur une note. Faites défiler vers le haut pour replacer les notes à leur position précédente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住聚拢快捷键并在便笺上向下滚动。向上滚动可将便笺还原到之前的位置。"
          }
        }
      }
    },
