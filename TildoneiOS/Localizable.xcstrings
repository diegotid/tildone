    "Sync is paused because Tildone’s storage in iCloud needs attention. Your notes remain safe on this iPhone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización está en pausa porque el almacenamiento de Tildone en iCloud necesita atención. Tus notas siguen a salvo en este iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation est suspendue car le stockage de Tildone dans iCloud nécessite votre attention. Vos notes restent en sécurité sur cet iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步已暂停，因为 Tildone 在 iCloud 中的存储需要处理。你的笔记仍安全保留在这台 iPhone 上。"
          }
        }
      }
    },
