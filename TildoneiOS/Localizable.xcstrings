    "Keep your notes, tasks, and progress together with iCloud. Use the same Apple Account on iPhone and Mac. Work offline and sync when you reconnect.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your notes, tasks, and progress together with iCloud. Use the same Apple Account on iPhone and Mac. Work offline and sync when you reconnect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén tus notas, tareas y progreso sincronizados con iCloud. Usa la misma cuenta de Apple en el iPhone y el Mac. Trabaja sin conexión y sincroniza al volver a conectarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrouvez vos notes, tâches et progrès grâce à iCloud. Utilisez le même compte Apple sur iPhone et Mac. Travaillez hors ligne et synchronisez à la reconnexion."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 iCloud 同步笔记、任务和进度。在 iPhone 和 Mac 上使用同一 Apple 账户。离线也能使用，重新联网后即可同步。"
          }
        }
      }
    },
