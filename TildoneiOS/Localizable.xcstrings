    },
    "Some synchronized data could not be read. Local editing is still available." : {
      "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudieron leer algunos datos sincronizados. Aún puedes editar localmente." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Certaines données synchronisées n’ont pas pu être lues. La modification locale reste possible." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "部分同步数据无法读取。仍可进行本地编辑。" } } }
    },
    "Sync is disabled" : {
