    },
    "Keep a Mac note’s text private by blurring it until you hover over the note.": {
      "comment": "Pro feature explanation or mock foreground window title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep a Mac note’s text private by blurring it until you hover over the note."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén privado el texto de una nota del Mac difuminándolo hasta que pases el cursor sobre ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préservez la confidentialité d’une note sur Mac en floutant son texte jusqu’au survol du pointeur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模糊 Mac 便笺的文字以保护隐私，将鼠标移到便笺上即可看清。"
          }
        }
      }
    },
