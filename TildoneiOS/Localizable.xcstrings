    },
    "Sync could not finish. You can keep editing; try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo completar la sincronización. Puedes seguir editando; inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation n’a pas pu se terminer. Vous pouvez continuer à modifier vos notes ; réessayez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步未能完成。你可以继续编辑；请重试。"
          }
        }
      }
    },
