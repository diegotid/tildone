    "Swipe a task to make a subtask or promote it. Creating or changing hierarchy requires Pro.": {
      "comment": "Release highlights and contextual feature discovery.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe a task to make a subtask or promote it. Creating or changing hierarchy requires Pro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza una tarea para convertirla en subtarea o subirla de nivel. Crear o cambiar la jerarquía requiere Pro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez une tâche pour en faire une sous-tâche ou la remonter d’un niveau. Créer ou modifier la hiérarchie nécessite Pro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滑动任务可将其变为子任务或提升层级。创建或更改层级需要 Pro。"
          }
        }
      }
    },
    "Sync Now": {
      "comment": "A button that triggers a sync.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizar ahora"
