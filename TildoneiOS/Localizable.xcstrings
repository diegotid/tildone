      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tildone is now on iPhone. Keep your notes, tasks, and progress together with iCloud using the same Apple Account. Work offline and sync when you reconnect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tildone llega al iPhone. Mantén tus notas, tareas y progreso sincronizados con iCloud usando la misma cuenta de Apple. Trabaja sin conexión y sincroniza al volver a conectarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tildone arrive sur iPhone. Retrouvez vos notes, tâches et progrès grâce à iCloud avec le même compte Apple. Travaillez hors ligne et synchronisez à la reconnexion."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tildone 现已登陆 iPhone。使用同一 Apple 账户，通过 iCloud 同步笔记、任务和进度。离线也能使用，重新联网后即可同步。"
          }
        }
      }
    },
    "Tildone, now in your pocket": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tildone, now in your pocket"
          }
