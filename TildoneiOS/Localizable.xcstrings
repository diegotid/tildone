    "To see existing Mac notes here, update Tildone on your Mac to version 2.0 or later. Both devices must use the same iCloud account." : {
      "comment" : "Guidance shown in the iCloud menu when no recently active Mac installation is detected.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To see existing Mac notes here, update Tildone on your Mac to version 2.0 or later. Both devices must use the same iCloud account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para ver aquí tus notas existentes del Mac, actualiza Tildone en tu Mac a la versión 2.0 o posterior. Ambos dispositivos deben usar la misma cuenta de iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour voir ici vos notes Mac existantes, mettez à jour Tildone sur votre Mac vers la version 2.0 ou ultérieure. Les deux appareils doivent utiliser le même compte iCloud."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要在这里查看 Mac 上现有的笔记，请将 Mac 上的 Tildone 更新到 2.0 或更高版本。两台设备必须使用同一个 iCloud 账户。"
          }
        }
      }
    },
