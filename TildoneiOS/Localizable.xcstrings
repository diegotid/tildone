    "You can keep editing. Changes will sync when iCloud is available." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes seguir editando. Los cambios se sincronizarán cuando iCloud esté disponible."
          }
        },
        "fr" : {
