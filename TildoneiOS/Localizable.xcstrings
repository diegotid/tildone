      "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Por privacidad, las notas de la cuenta anterior ya no se muestran. Reinicia la app después de cambiar de cuenta." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Pour protéger votre confidentialité, les notes du compte précédent ne sont plus affichées. Relancez l’app après avoir changé de compte." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "为保护隐私，已不再显示上一个账户的笔记。切换账户后请重新启动 App。" } } }
