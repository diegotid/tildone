    "Tildone can combine the notes on this iPhone with your private iCloud notes. The originals will remain on this iPhone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tildone puede combinar las notas de este iPhone con tus notas privadas de iCloud. Los originales permanecerán en este iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tildone peut combiner les notes de cet iPhone avec vos notes iCloud privées. Les originaux resteront sur cet iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tildone 可以将此 iPhone 上的备忘录与你的私人 iCloud 备忘录合并。原始内容仍会保留在此 iPhone 上。"
          }
        }
      }
    },
    "Tildone cannot access iCloud. Check iCloud access in Settings.": {
      "localizations": {
        "es": {
