    "Break a task into smaller steps and keep them together in a clear hierarchy.": {
      "comment": "Pro feature explanation or mock note content used only in paywall previews.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Break a task into smaller steps and keep them together in a clear hierarchy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Divide una tarea en pasos más pequeños y agrúpalos en una jerarquía clara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décomposez une tâche en petites étapes et regroupez-les dans une hiérarchie claire."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将任务拆分成小步骤，并用清晰的层级将它们归为一组。"
          }
        }
      }
    },
    "Break a task into smaller steps, see their progress, and collapse them when you want a simpler view.": {
      "comment": "Release highlights and contextual feature discovery.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Break a task into smaller steps, see their progress, and collapse them when you want a simpler view."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Divide una tarea en pasos más pequeños, consulta su progreso y contráelos cuando quieras una vista más sencilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décomposez une tâche en petites étapes, suivez leur progression et repliez-les pour simplifier l’affichage."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将任务分成小步骤，查看进度，并在需要简洁视图时折叠它们。"
          }
        }
      }
    },
    "Bring Mac notes together in a corner, then return them to their previous positions.": {
      "comment": "Pro feature explanation or mock note content used only in paywall previews.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring Mac notes together in a corner, then return them to their previous positions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reúne las notas del Mac en una esquina y devuélvelas después a sus posiciones anteriores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rassemblez les notes sur Mac dans un coin, puis remettez-les à leurs positions précédentes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 Mac 便笺聚拢到角落，再恢复到之前的位置。"
          }
        }
      }
    },
