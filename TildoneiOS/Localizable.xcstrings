    "The change could not be undone. Your notes were not otherwise changed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo deshacer el cambio. Tus notas no se modificaron de ninguna otra forma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La modification n’a pas pu être annulée. Vos notes n’ont pas été modifiées autrement."
