    "Capture ideas and manage tasks on iPhone. A companion to Tildone for Mac, it also works on its own. No Mac required.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture ideas and manage tasks on iPhone. A companion to Tildone for Mac, it also works on its own. No Mac required."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Captura ideas y gestiona tareas en el iPhone. Complementa Tildone para Mac y también funciona por sí sola. No necesitas un Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notez vos idées et gérez vos tâches sur iPhone. Complément de Tildone pour Mac, l’app fonctionne aussi de façon autonome. Aucun Mac nécessaire."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上记录灵感、管理任务。它既是 Mac 版 Tildone 的配套应用，也能独立使用，无需 Mac。"
          }
        }
      }
    },
    "Change Note Color": {
      "localizations": {
