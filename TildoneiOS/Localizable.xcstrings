    },
    "Synced data was created by a newer version of Tildone." : {
      "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Los datos sincronizados se crearon con una versión más reciente de Tildone." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les données synchronisées ont été créées par une version plus récente de Tildone." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "同步数据由较新版本的 Tildone 创建。" } } }
    },
    "Synchronization could not finish. Local editing is still available; try again." : {
      "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo completar la sincronización. Aún puedes editar localmente; inténtalo de nuevo." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "La synchronisation n’a pas pu se terminer. La modification locale reste possible ; réessayez." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "同步未能完成。仍可进行本地编辑；请重试。" } } }
    },
    "Synchronization is paused until this workspace is reviewed." : {
