    "Changes stay on this iPhone while iCloud sync is turned off.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios permanecen en este iPhone mientras la sincronización con iCloud está desactivada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications restent sur cet iPhone tant que la synchronisation iCloud est désactivée."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 同步关闭期间，更改将保留在这台 iPhone 上。"
          }
        }
      }
    },
