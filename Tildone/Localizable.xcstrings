        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tildone"
          }
        }
      }
    },
    "Tildone cannot use iCloud with this account. You can keep editing on this Mac." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tildone no puede usar iCloud con esta cuenta. Puedes seguir editando en este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tildone ne peut pas utiliser iCloud avec ce compte. Vous pouvez continuer à modifier vos notes sur ce Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
