        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设置会永久删除任务，且无法恢复。"
          }
        }
      }
    },
    "This shortcut is used by another app. Choose another shortcut to make it work globally." : {
      "localizations" : {
        "es" : {
