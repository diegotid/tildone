            "state" : "translated",
            "value" : "访问发行说明"
          }
        }
      }
    },
    "When menu command used or ⇧⌘A pressed:" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando se usa el comando del menú o se presiona ⇧⌘A:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque la commande du menu est utilisée ou que ⇧⌘A est pressé :"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当使用菜单命令或按下 ⇧⌘A 时："
          }
        }
      }
    },
    "Wrap to multiple lines" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustar a varias líneas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passer sur plusieurs lignes"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多行显示"
          }
        }
      }
    },
    "Your existing notes have not been changed. Tildone needs your help before it can open them." : {
      "comment" : "A message displayed when Tildone fails to open a user's notes.",
      "isCommentAutoGenerated" : true,
      "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Tus notas existentes no se han modificado. Tildone necesita tu ayuda antes de poder abrirlas." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Vos notes existantes n’ont pas été modifiées. Tildone a besoin de votre aide avant de pouvoir les ouvrir." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你现有的笔记未被更改。Tildone 需要你的帮助才能打开它们。" } } }
    },
    "Untitled task" : {
      "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Tarea sin título" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Tâche sans titre" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无标题任务" } } }
    },
    "Copy Notes to iCloud…" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Copiar notas a iCloud…" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Copier les notes vers iCloud…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将笔记复制到 iCloud…" } } } },
    "Copy Notes" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Copiar notas" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Copier les notes" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "复制笔记" } } } },
    "Copy notes to iCloud?" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "¿Copiar las notas a iCloud?" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Copier les notes vers iCloud ?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将笔记复制到 iCloud？" } } } },
    "Changes waiting to sync: %lld" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Cambios pendientes de sincronizar: %lld" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Modifications en attente de synchronisation : %lld" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "等待同步的更改：%lld" } } } },
    "You can keep editing. Nothing will be sent to or downloaded from iCloud until you resume." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Puedes seguir editando. No se enviará ni descargará nada de iCloud hasta que reanudes la sincronización." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Vous pouvez continuer à modifier vos notes. Rien ne sera envoyé vers iCloud ni téléchargé depuis iCloud avant la reprise." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你可以继续编辑。恢复同步前，不会向 iCloud 发送或从中下载任何内容。" } } } },
    "Your notes remain on this Mac. You can choose to copy them to iCloud. Nothing will be deleted." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Tus notas permanecen en este Mac. Puedes elegir copiarlas a iCloud. No se eliminará nada." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Vos notes restent sur ce Mac. Vous pouvez choisir de les copier vers iCloud. Rien ne sera supprimé." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你的笔记仍保留在这台 Mac 上。你可以选择将其复制到 iCloud。不会删除任何内容。" } } } },
    "Your notes remain safe on this Mac. There are also notes in iCloud, so Tildone will not combine or replace either set automatically." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Tus notas siguen a salvo en este Mac. También hay notas en iCloud, por lo que Tildone no combinará ni sustituirá automáticamente ninguno de los dos conjuntos." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Vos notes restent en sécurité sur ce Mac. Il existe aussi des notes dans iCloud ; Tildone ne combinera ni ne remplacera automatiquement aucun des deux ensembles." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你的笔记仍安全保留在这台 Mac 上。iCloud 中也有笔记，因此 Tildone 不会自动合并或替换任何一组笔记。" } } } },
    "Open Tildone and review iCloud sync status" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Abrir Tildone y revisar el estado de sincronización con iCloud" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ouvrir Tildone et consulter l’état de la synchronisation iCloud" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开 Tildone 并查看 iCloud 同步状态" } } } },
    "Pause Sync" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Pausar sincronización" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Suspendre la synchronisation" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "暂停同步" } } } },
    "Resume Sync" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Reanudar sincronización" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Reprendre la synchronisation" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "恢复同步" } } } },
    "Tildone needs your help with iCloud. It has not deleted or replaced any notes." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Tildone necesita tu ayuda con iCloud. No ha eliminado ni sustituido ninguna nota." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Tildone a besoin de votre aide avec iCloud. Aucune note n’a été supprimée ni remplacée." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Tildone 需要你协助处理 iCloud 问题。它没有删除或替换任何笔记。" } } } },
    "Sign in to iCloud with the account you want to use, then reopen Tildone. Notes saved on this Mac will not be uploaded automatically." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Inicia sesión en iCloud con la cuenta que quieras usar y vuelve a abrir Tildone. Las notas guardadas en este Mac no se subirán automáticamente." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Connectez-vous à iCloud avec le compte voulu, puis rouvrez Tildone. Les notes enregistrées sur ce Mac ne seront pas envoyées automatiquement." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "使用你想要的帐户登录 iCloud，然后重新打开 Tildone。这台 Mac 上保存的笔记不会自动上传。" } } } },
    "Sync Now" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Sincronizar ahora" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Synchroniser maintenant" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "立即同步" } } } },
    "Sync Status…" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Estado de sincronización…" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "État de la synchronisation…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "同步状态…" } } } },
    "Sync could not finish. You can keep editing, and your unsent changes remain safe." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo completar la sincronización. Puedes seguir editando y tus cambios sin enviar permanecen a salvo." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "La synchronisation n’a pas pu se terminer. Vous pouvez continuer à modifier vos notes et les changements non envoyés restent en sécurité." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "同步未能完成。你可以继续编辑，尚未发送的更改会安全保留。" } } } },
    "The iCloud account changed. Tildone stopped syncing the previous account’s notes to keep them separate." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "La cuenta de iCloud ha cambiado. Tildone ha dejado de sincronizar las notas de la cuenta anterior para mantenerlas separadas." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le compte iCloud a changé. Tildone a arrêté de synchroniser les notes du compte précédent afin de les garder séparées." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "iCloud 帐户已更改。为将笔记分开保存，Tildone 已停止同步先前帐户的笔记。" } } } },
    "Tildone’s storage in iCloud is missing or was reset. Sync has stopped, but your notes and unsent changes are safe. Tildone will not rebuild or upload them again without your permission." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "El almacenamiento de Tildone en iCloud falta o se ha restablecido. La sincronización se ha detenido, pero tus notas y cambios sin enviar están a salvo. Tildone no los reconstruirá ni volverá a subirlos sin tu permiso." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le stockage de Tildone dans iCloud est absent ou a été réinitialisé. La synchronisation est arrêtée, mais vos notes et changements non envoyés sont en sécurité. Tildone ne les reconstruira ni ne les renverra sans votre autorisation." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Tildone 在 iCloud 中的存储缺失或已被重置。同步已停止，但你的笔记和尚未发送的更改会安全保留。未经你的许可，Tildone 不会重新建立或再次上传它们。" } } } },
    "iCloud sync is turned off in this version of Tildone. Your notes stay where they are." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "La sincronización con iCloud está desactivada en esta versión de Tildone. Tus notas permanecen donde están." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "La synchronisation iCloud est désactivée dans cette version de Tildone. Vos notes restent là où elles se trouvent." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此版本的 Tildone 已关闭 iCloud 同步。你的笔记会保留在原处。" } } } },
    "The notes in iCloud were saved by a newer version of Tildone. You can keep editing on this Mac, and Tildone will not replace the iCloud notes." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Las notas de iCloud se guardaron con una versión más reciente de Tildone. Puedes seguir editando en este Mac y Tildone no sustituirá las notas de iCloud." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les notes dans iCloud ont été enregistrées avec une version plus récente de Tildone. Vous pouvez continuer à les modifier sur ce Mac et Tildone ne remplacera pas les notes iCloud." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "iCloud 中的笔记由较新版本的 Tildone 保存。你可以继续在这台 Mac 上编辑，Tildone 不会替换 iCloud 中的笔记。" } } } },
    "Tildone cannot use iCloud with this account. You can keep editing on this Mac." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Tildone no puede usar iCloud con esta cuenta. Puedes seguir editando en este Mac." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Tildone ne peut pas utiliser iCloud avec ce compte. Vous pouvez continuer à modifier vos notes sur ce Mac." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Tildone 无法通过此帐户使用 iCloud。你可以继续在这台 Mac 上编辑。" } } } },
    "Tildone sends and receives your changes through iCloud." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Tildone envía y recibe tus cambios mediante iCloud." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Tildone envoie et reçoit vos changements via iCloud." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Tildone 通过 iCloud 发送和接收你的更改。" } } } },
    "Tildone will copy the notes saved on this Mac to iCloud. This is available because there are no Tildone notes in iCloud. The originals will remain on this Mac, and nothing will be deleted." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Tildone copiará a iCloud las notas guardadas en este Mac. Esta opción está disponible porque no hay notas de Tildone en iCloud. Los originales permanecerán en este Mac y no se eliminará nada." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Tildone copiera vers iCloud les notes enregistrées sur ce Mac. Cette option est disponible car aucune note Tildone ne se trouve dans iCloud. Les originaux resteront sur ce Mac et rien ne sera supprimé." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Tildone 会将这台 Mac 上保存的笔记复制到 iCloud。此选项可用是因为 iCloud 中没有 Tildone 笔记。原始笔记会保留在这台 Mac 上，不会删除任何内容。" } } } },
    "Tildone is using the notes saved on this Mac. Notes in iCloud are unchanged, and you can switch at any time." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Tildone está usando las notas guardadas en este Mac. Las notas de iCloud no han cambiado y puedes cambiar de opción en cualquier momento." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Tildone utilise les notes enregistrées sur ce Mac. Les notes dans iCloud restent inchangées et vous pouvez changer d’option à tout moment." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Tildone 正在使用这台 Mac 上保存的笔记。iCloud 中的笔记保持不变，你可以随时切换。" } } } },
    "Tildone could not finish that change. Nothing was deleted. Please try again." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Tildone no pudo completar ese cambio. No se ha eliminado nada. Inténtalo de nuevo." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Tildone n’a pas pu terminer ce changement. Rien n’a été supprimé. Réessayez." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Tildone 无法完成这项更改。没有删除任何内容。请重试。" } } } },
    "Review Options…" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Revisar opciones…" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Examiner les options…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "查看选项…" } } } },
    "Change Which Notes Tildone Uses…" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Cambiar qué notas usa Tildone…" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Changer les notes utilisées par Tildone…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "更改 Tildone 使用的笔记…" } } } },
    "Choose which notes Tildone should use" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Elige qué notas debe usar Tildone" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Choisissez les notes que Tildone doit utiliser" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "选择 Tildone 应使用的笔记" } } } },
    "Your notes on this Mac and in iCloud will remain saved whichever option you choose." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Tus notas de este Mac y de iCloud seguirán guardadas elijas la opción que elijas." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Vos notes sur ce Mac et dans iCloud resteront enregistrées, quelle que soit l’option choisie." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无论选择哪个选项，这台 Mac 和 iCloud 中的笔记都会保留。" } } } },
    "Combine Notes — Recommended" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Combinar notas — Recomendado" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Combiner les notes — Recommandé" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "合并笔记 — 推荐" } } } },
    "Add the notes from this Mac to the notes in iCloud, then use the combined set." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Añade las notas de este Mac a las de iCloud y después usa el conjunto combinado." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ajoutez les notes de ce Mac à celles d’iCloud, puis utilisez l’ensemble obtenu." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将这台 Mac 上的笔记添加到 iCloud 笔记中，然后使用合并后的笔记。" } } } },
    "Use iCloud Notes" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Usar notas de iCloud" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Utiliser les notes iCloud" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "使用 iCloud 笔记" } } } },
    "Show the notes already in iCloud. The notes on this Mac stay saved." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Muestra las notas que ya están en iCloud. Las notas de este Mac siguen guardadas." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Affichez les notes déjà présentes dans iCloud. Les notes de ce Mac restent enregistrées." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "显示 iCloud 中已有的笔记。这台 Mac 上的笔记会继续保留。" } } } },
    "Use Notes on This Mac" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Usar las notas de este Mac" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Utiliser les notes de ce Mac" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "使用这台 Mac 上的笔记" } } } },
    "Keep showing the notes saved on this Mac. The notes in iCloud stay unchanged." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Sigue mostrando las notas guardadas en este Mac. Las notas de iCloud no cambian." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Continuez à afficher les notes enregistrées sur ce Mac. Les notes dans iCloud restent inchangées." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "继续显示这台 Mac 上保存的笔记。iCloud 中的笔记保持不变。" } } } },
    "Decide Later" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Decidir más tarde" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Décider plus tard" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "稍后决定" } } } },
    "Combine notes from this Mac and iCloud?" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "¿Combinar las notas de este Mac y de iCloud?" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Combiner les notes de ce Mac et d’iCloud ?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "合并这台 Mac 和 iCloud 中的笔记？" } } } },
    "Use the notes on this Mac?" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "¿Usar las notas de este Mac?" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Utiliser les notes de ce Mac ?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "使用这台 Mac 上的笔记？" } } } },
    "Use the notes in iCloud?" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "¿Usar las notas de iCloud?" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Utiliser les notes dans iCloud ?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "使用 iCloud 中的笔记？" } } } },
    "Combine Notes" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Combinar notas" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Combiner les notes" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "合并笔记" } } } },
    "Use This Mac" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Usar este Mac" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Utiliser ce Mac" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "使用这台 Mac" } } } },
    "Use iCloud" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Usar iCloud" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Utiliser iCloud" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "使用 iCloud" } } } },
    "Tildone will add the notes from this Mac to iCloud. If the same note exists in both places, Tildone will combine it the same way it handles edits made on two devices. The notes saved on this Mac will remain available." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Tildone añadirá a iCloud las notas de este Mac. Si la misma nota existe en ambos lugares, Tildone la combinará igual que cuando se edita en dos dispositivos. Las notas guardadas en este Mac seguirán disponibles." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Tildone ajoutera à iCloud les notes de ce Mac. Si la même note existe aux deux endroits, Tildone la combinera comme lorsqu’elle est modifiée sur deux appareils. Les notes enregistrées sur ce Mac resteront disponibles." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Tildone 会将这台 Mac 上的笔记添加到 iCloud。如果两个位置有同一条笔记，Tildone 会像处理两台设备上的编辑一样进行合并。这台 Mac 上保存的笔记仍会保留。" } } } },
    "Tildone will keep showing the notes saved on this Mac. The notes in iCloud will not be changed, and you can switch later." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Tildone seguirá mostrando las notas guardadas en este Mac. Las notas de iCloud no cambiarán y podrás cambiar de opción más tarde." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Tildone continuera à afficher les notes enregistrées sur ce Mac. Les notes dans iCloud ne seront pas modifiées et vous pourrez changer d’option plus tard." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Tildone 将继续显示这台 Mac 上保存的笔记。iCloud 中的笔记不会更改，你可以稍后切换。" } } } },
    "Tildone will show the notes in iCloud. The notes saved on this Mac will not be changed, and you can switch back later." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Tildone mostrará las notas de iCloud. Las notas guardadas en este Mac no cambiarán y podrás volver a ellas más tarde." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Tildone affichera les notes dans iCloud. Les notes enregistrées sur ce Mac ne seront pas modifiées et vous pourrez y revenir plus tard." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Tildone 将显示 iCloud 中的笔记。这台 Mac 上保存的笔记不会更改，你可以稍后切换回来。" } } } },
    "iCloud Sync" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Sincronización con iCloud" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Synchronisation iCloud" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "iCloud 同步" } } } },
    "iCloud is temporarily unavailable. You can keep editing, and your unsent changes remain safe." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "iCloud no está disponible temporalmente. Puedes seguir editando y tus cambios sin enviar permanecen a salvo." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "iCloud est temporairement indisponible. Vous pouvez continuer à modifier vos notes et les changements non envoyés restent en sécurité." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "iCloud 暂时不可用。你可以继续编辑，尚未发送的更改会安全保留。" } } } },
    "iCloud sync is active" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "La sincronización con iCloud está activa" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "La synchronisation iCloud est active" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "iCloud 同步已启用" } } } },
    "iCloud sync is disabled" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "La sincronización con iCloud está desactivada" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "La synchronisation iCloud est désactivée" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "iCloud 同步已停用" } } } },
    "iCloud sync is paused" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "La sincronización con iCloud está pausada" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "La synchronisation iCloud est suspendue" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "iCloud 同步已暂停" } } } },
    "iCloud sync needs attention" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "La sincronización con iCloud necesita atención" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "La synchronisation iCloud nécessite votre attention" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "iCloud 同步需要处理" } } } },
    "Your notes remain on this Mac." : {
      "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Tus notas permanecen en este Mac." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Vos notes restent sur ce Mac." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你的笔记仍保留在这台 Mac 上。" } } }
    }
  },
  "version" : "1.1"
}
