    "When enabled, hold ⌘ while clicking to interact with a transparent note. (When disabled, press ⌘ while clicking to click through.)" : {
      "comment" : "A description of the dimming feature.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando esté activado, mantén pulsado ⌘ mientras haces clic para interactuar con una nota transparente. (Cuando esté desactivado, pulsa ⌘ mientras haces clic para que el clic la atraviese.)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque cette option est activée, maintenez ⌘ pendant le clic pour interagir avec une note transparente. (Lorsqu’elle est désactivée, appuyez sur ⌘ pendant le clic pour cliquer à travers.)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，按住 ⌘ 并点击即可与透明笔记交互。（停用后，点击时按住 ⌘ 即可穿透。）"
          }
        }
      }
    },
