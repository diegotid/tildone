    "Focus Filters can automatically blur task text or let notes stay behind other windows while a Focus is active." : {
      "comment" : "A description of how Focus Filters work.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los filtros de concentración pueden desenfocar automáticamente el texto de las tareas o permitir que las notas permanezcan detrás de otras ventanas mientras haya un modo de concentración activo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les filtres de concentration peuvent automatiquement flouter le texte des tâches ou laisser les notes derrière les autres fenêtres lorsqu’un mode de concentration est actif."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "专注模式过滤条件可在专注模式启用时自动模糊任务文本，或让便笺保持在其他窗口后方。"
          }
        }
      }
    },
