    "Add Shift to apply the dimming change to all notes. Shift cannot be part of the shortcut itself." : {
      "comment" : "A description of how to add the shift modifier to the dimming shortcut.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade Mayúsculas para aplicar el cambio de atenuación a todas las notas. Mayúsculas no puede formar parte del atajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez Maj pour appliquer la variation d’atténuation à toutes les notes. La touche Maj ne peut pas faire partie du raccourci."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加 Shift 可将变暗调整应用到所有笔记。Shift 不能包含在快捷键中。"
          }
        }
      }
    },
    "Add the notes from this Mac to the notes in iCloud, then use the combined set." : {
      "localizations" : {
